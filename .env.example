# ============================================================================
# Linkco MR - environment configuration (placeholders only; never commit real
# values). Copy to .env (git-ignored) / Docker secrets / systemd EnvironmentFile.
# ============================================================================

# --- Core app (existing) ----------------------------------------------------
WOMS_PORT=8000
WOMS_JWT_SECRET=
WOMS_CORS_ORIGINS=

# --- Dual backup system -----------------------------------------------------
# Master switch for the dual backup (local + SMB). The daily schedule itself
# lives in the app (Settings > Backup > time), default 02:00.
BACKUP_ENABLED=true

# Local destination. Use e.g. D:\Application-Backups on Windows,
# /backup on a dedicated Linux disk. Structure: Daily/ Weekly/ Monthly/ status/
LOCAL_BACKUP_PATH=/backup

# SMB network backup - second, independent destination (\\FILESERVER\MR-Backup)
# Transport:
#   mount     = the share is ALREADY MOUNTED at SMB_MOUNT_PATH (CIFS mount /
#               Docker volume - mount commands in docs/backup.md section 4).
#               The app only copies into that folder: if the share is not
#               actually mounted there, the run reports SMB FAILED and
#               PARTIAL_SUCCESS on purpose (a plain local folder is NOT the
#               file server). Credentials live in the OS mount, not here.
#   smbclient = push directly with the smbclient binary - this is the mode
#               where SMB_SERVER/USERNAME/PASSWORD below are used.
# Values: SMB_SERVER is the BARE server name/IP (never \\UNC),
#         SMB_USERNAME is the service ACCOUNT name (never a share path).
# DEDICATED service account only (e.g. LINKCO\svc_mr_backup) - never a
# person's AD account. Secrets come from the environment/secret store and
# are never committed.
SMB_BACKUP_ENABLED=false
SMB_MODE=mount
SMB_MOUNT_PATH=/mnt/mr-backup
SMB_SERVER=FILESERVER
SMB_SHARE=MR-Backup
SMB_DOMAIN=LINKCO
SMB_USERNAME=svc_mr_backup
SMB_PASSWORD=

# Retention (applied independently to LOCAL and SMB)
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4
BACKUP_MONTHLY_RETENTION=12

# Optional AES-256-GCM encryption of the backup package.
# Generate a key:  python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep the key OUT of the backed-up machine (secret manager / offline copy).
BACKUP_ENCRYPTION_ENABLED=false
BACKUP_ENCRYPTION_KEY=

# Extra paths to include in the package (colon-separated on Linux,
# semicolon on Windows). App data (db snapshot, Excel, uploads, app_config,
# .jwt_secret) is always included automatically.
# BACKUP_PATHS=/app/secrets:/srv/export
# --- Network drive (in-browser shared files) ---------------------------------
# Folder users browse/upload/view at /files. Point it at a mounted share
# (e.g. /mnt/company-files) to serve that drive in the browser. Default:
# data/netdrive. The app only ever accesses paths INSIDE this root.
NETDRIVE_PATH=
